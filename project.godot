; Engine configuration file.
; This project is pinned to Godot 4.7.2 stable.

config_version=5

[application]

config/name="Forbidden Table"
config/version="1.0.0-rc.2"
config/features=PackedStringArray("4.7", "GL Compatibility")
run/main_scene="res://scenes/run/run_scene.tscn"

[autoload]

PresentationPrefs="*res://src/presentation/localization/presentation_preferences.gd"

[display]

window/size/viewport_width=960
window/size/viewport_height=540

[internationalization]

locale/fallback="en"
locale/translations=PackedStringArray("res://localization/en.en.translation", "res://localization/zh_CN.zh_CN.translation")
pseudolocalization/expansion_ratio=0.3
pseudolocalization/skip_placeholders=true
rendering/root_node_auto_translate=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
